# ============================================================
# Dockerfile.dashboard — ABSA Streamlit Monitoring Dashboard
# ============================================================

FROM python:3.10.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_dashboard.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements_dashboard.txt

COPY src/           ./src/
COPY monitoring/    ./monitoring/
COPY absa_models/   ./absa_models/
COPY logs/          ./logs/

RUN useradd -m -u 1000 absa && chown -R absa:absa /app
USER absa

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8501/_stcore/health', timeout=5)"

CMD ["streamlit", "run", "monitoring/monitoring_dashboard.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true"]
