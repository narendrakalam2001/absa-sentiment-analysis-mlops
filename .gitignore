# ============================================================
# .gitignore — ABSA Sentiment Analysis
# ============================================================

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environments ───────────────────────────────────────
venv/
env/
.venv/
.env/
ml_env/

# ── Jupyter ────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Test artifacts ─────────────────────────────────────────────
.coverage
.pytest_cache/
htmlcov/
coverage.xml

# ── MLflow (auto-generated) ────────────────────────────────────
mlruns/
mlartifacts/

# ── Prediction logs (auto-generated at runtime) ────────────────
logs/prediction_logs.csv

# ── OS / IDE ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Secrets ────────────────────────────────────────────────────
.env
*.key
secrets.json

# ── Build ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ============================================================
# ✅ PUSHED TO GITHUB (NOT ignored):
#
#   absa_models/*.joblib  ← Champion model — Render needs this!
#   absa_models/*.json    ← latest_model.json, challenger_log.json
#   absa_models/*.csv     ← monitor_scores.csv, drift report
#   data/sample_absa.csv  ← sample dataset
#   docs/                 ← all plots, screenshots, SVG, gifs
#   src/                  ← all ML source files
#   serving/              ← FastAPI (Render needs this)
#   monitoring/           ← Streamlit dashboard
#   requirements_api.txt  ← Render build command uses this
#   render.yaml           ← Render config
#   runtime.txt           ← Python version
#   Dockerfile*           ← Docker deploy
#   .github/workflows/    ← CI/CD
# ============================================================